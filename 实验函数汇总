clear all
t = (0:0.05:18)';  
N = length(t);  
zeta = 0.2:0.2:1.4;  
L = length(zeta);  
y = zeros(N, L);
hold on  
for k = 1:L  
    zk = zeta(k);  
    if zk < 1  
        beta = sqrt(1 - zk^2);  
        y(:,k) = 1/beta * exp(-zk*t) .* sin(beta*t);  
        plot(t, y(:,k), 'b-')  
    elseif zk == 1  
        y(:,k) = t .* exp(-t);  
        plot(t, y(:,k), 'k-', 'LineWidth', 2) % 粗黑线
        hold on;
    else  
        beta = sqrt(zk^2 - 1);  
        y(:,k) = (exp(-(zk-beta)*t) - exp(-(zk+beta)*t)) ./ (2*beta);  
        plot(t, y(:,k), 'r-')  
    end  
end 
if any(zeta == 0.2)  
    text(2.2, 0.63, '\zeta = 0.2')  
end  
if any(zeta == 1.4)  
    text(0.3, 0.14, '\zeta = 1.4')  
end  
text(10, 0.7, '\Delta\zeta = 0.2')  
  
axis([0, 18, -0.4, 0.8])  
hold off  
box on  
grid on
 

