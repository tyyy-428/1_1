#include<stdio.h>
int main()
{
    double score[3] = { 0 };
    char* c;
    while (1)
    {
        printf("请输入你的语文成绩：");
        if (scanf("%lf", &score[0]) && score[0] >= 0 && score[0] <= 100)
            break;
        else
        {
            printf("输入不合理！请重新输入！\n");
            scanf("%s", &c);
        }
    };
    while (1)
    {
        printf("请输入你的数学成绩：");
        if (scanf("%lf", &score[1]) && score[1] >= 0 && score[1] <= 100)
            break;
        else
        {
            printf("输入不合理！请重新输入！\n");
            scanf("%s", &c);
        }
    };
    while (1)
    {
        printf("请输入你的英语成绩：");
        if (scanf("%lf", &score[2]) && score[2] >= 0 && score[2] <= 100)
            break;
        else
        {
            printf("输入不合理！请重新输入！\n");
            scanf("%s", &c);
        }
    };
    double max = score[0];
    double min = score[0];
    double average = (score[0] + score[1] + score[2]) / 3;
    for (int i = 1; i < 3; i++)
    {
        if (max < score[i])
            max = score[i];
        if (min > score[i])
            min = score[i];
    }
    printf("你的平均分为：%.1f\n你的最高分为：%.1f\n你的最低分为：%.1f\n你的等级为：", average, max, min);
    if (average > 90)
        printf("优！\n");
    else if(average >= 80)
        printf("良！\n");
    else if(average >= 60)
        printf("中！\n");
    else
        printf("差！\n");
    return 0;
}
