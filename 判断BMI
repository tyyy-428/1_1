#include<stdio.h>
int main()
{
    double w, h,bim;
    char* c;
    while (1)
    {
        printf("请输入你的体重(kg):");
        if (scanf("%lf", &w))
            break;
        else
            scanf("%s", &c);
    };
    while (1)
    {
        printf("请输入你的身高(cm):");
        if (scanf("%lf", &h))
            break;
        else
            scanf("%s", &c);
    };
    h = h / 100;
    bim = w / (h * h);
    printf("你的bim指数为%.1f\n", bim);
    if (bim < 18.5)
        printf("你体重偏瘦！");
    else if(bim < 24)
        printf("你体重正常！");
    else if(bim < 28)
        printf("你体重过重！");
    else
        printf("你体重肥胖！");
    return 0;
}
