ax2 = axes('Position', position, 'XAxisLocation', 'top', 'YAxisLocation', 'right', ...
           'Color', 'none', 'XColor', 'k', 'YColor', 'none');
linkaxes([ax, ax2], 'x'); 

% 设置第二个x轴
